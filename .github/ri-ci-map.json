{
  "schema_version": 1,
  "review": {
    "issue": "https://github.com/oborskyivitalii/oborskyivitalii/issues/31",
    "summary": "RI controls and acceptance protocol are mapped to unconditional CI entrypoints; dated memory and live GitHub facts retain separate acceptance. Refresh this record only after reviewing affected tests and workflow routes."
  },
  "layers": [
    {
      "id": "authority-instructions",
      "purpose": "Enduring agent rules, source authority and entry routes; history cannot supply current instructions.",
      "paths": [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "PROJECT-BOOTSTRAP.md"
      ],
      "checks": [
        "ri-regressions",
        "ri-freshness",
        "acceptance-policy"
      ]
    },
    {
      "id": "intent-acceptance",
      "purpose": "Owning issue intent and measurable criteria; execution and model reviews are linked PR artifacts. Automated and manual criteria stay distinct.",
      "paths": [
        ".github/ACCEPTANCE.md",
        ".github/ISSUE_TEMPLATE/work-item.md",
        ".github/ISSUE_TEMPLATE/research-input.md",
        ".github/pull_request_template.md",
        "review/REVIEW-TEMPLATE.md",
        "review/issue-31/2026-10-07-analysis.md",
        ".github/acceptance/issue-31.json",
        "tools/issue_acceptance.py",
        "tests/test_issue_acceptance.py",
        "tests/test_issue31_acceptance.py"
      ],
      "checks": [
        "acceptance-policy-selection",
        "acceptance-policy",
        "ri-ci-regressions"
      ]
    },
    {
      "id": "path-catalog",
      "purpose": "Complete file/directory purposes, roles and owners; unknown or stale paths fail visibly.",
      "paths": [
        ".github/repository-paths.json"
      ],
      "checks": [
        "ri-regressions",
        "ri-freshness",
        "ri-ci-map"
      ]
    },
    {
      "id": "producer-identity",
      "purpose": "Pinned upstream provenance, site interpretation, bounds, exact byte identity and input safety.",
      "paths": [
        "tools/repository_intelligence.py",
        ".github/repository-intelligence-config.json",
        "tests/test_repository_intelligence.py"
      ],
      "checks": [
        "ri-regressions",
        "ri-freshness",
        "ri-ci-map"
      ]
    },
    {
      "id": "generated-views",
      "purpose": "Readable map and agent context derive from one projection; neither is editing authority.",
      "paths": [
        "REPOSITORY-MAP.md",
        ".github/repository-intelligence/agent-context.json"
      ],
      "checks": [
        "ri-regressions",
        "ri-freshness"
      ]
    },
    {
      "id": "lookup-validation-routes",
      "purpose": "Explainable owner candidates and actual CI/check companions; suggestions never claim test results.",
      "paths": [
        ".github/REPOSITORY-INTELLIGENCE.md",
        ".github/ri-ci-map.json",
        "tools/check_ri_ci.py",
        "tests/test_ri_ci.py",
        ".github/workflows/navigation.yml"
      ],
      "checks": [
        "ri-regressions",
        "ri-ci-map",
        "ri-ci-regressions"
      ]
    },
    {
      "id": "continuity",
      "purpose": "Bounded dated handoff, update rules and required sections; current facts need live revalidation.",
      "paths": [
        "MEMORY.md"
      ],
      "checks": [
        "ri-regressions",
        "ri-freshness",
        "acceptance-policy"
      ]
    },
    {
      "id": "github-live-overlay-ci-boundary",
      "purpose": "CI entrypoints and exact-source reports are indexed, while live issue/review/check/deployment state and owner acceptance remain external observations.",
      "paths": [
        ".github/workflows/issue-acceptance.yml",
        ".github/workflows/site-checks.yml",
        ".github/workflows/site-browser-gate-probe.yml",
        ".github/workflows/site-candidate-evidence.yml",
        ".github/workflows/site-release-checks.yml",
        ".github/workflows/site-staging.yml",
        ".github/workflows/site-cause-probe.yml",
        ".github/workflows/site-cause-fix-probe.yml",
        ".github/workflows/site-gtk-target-probe.yml",
        ".github/workflows/site-gtk-native-probe.yml",
        ".github/workflows/site-color-review.yml",
        ".github/workflows/site-navigation-probe.yml",
        ".github/workflows/site-writing-probe.yml",
        ".github/workflows/site-runtime-checks.yml"
      ],
      "checks": [
        "acceptance-policy-selection",
        "acceptance-policy",
        "site-basic",
        "ri-ci-map"
      ]
    }
  ],
  "checks": [
    {
      "id": "ri-regressions",
      "workflow": ".github/workflows/navigation.yml",
      "job": "navigation",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_repository_intelligence.py"
      ],
      "test_selectors": [
        "test_repository_intelligence.NavigationSafetyTests"
      ]
    },
    {
      "id": "ri-freshness",
      "workflow": ".github/workflows/navigation.yml",
      "job": "navigation",
      "argv": [
        "python3",
        "tools/repository_intelligence.py",
        "--config",
        ".github/repository-intelligence-config.json",
        "verify"
      ]
    },
    {
      "id": "ri-ci-map",
      "workflow": ".github/workflows/navigation.yml",
      "job": "navigation",
      "argv": [
        "python3",
        "tools/check_ri_ci.py",
        "verify"
      ]
    },
    {
      "id": "ri-ci-regressions",
      "workflow": ".github/workflows/navigation.yml",
      "job": "navigation",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_ri_ci.py"
      ],
      "test_selectors": [
        "test_ri_ci.RICICouplingTests"
      ]
    },
    {
      "id": "acceptance-policy-selection",
      "workflow": ".github/workflows/issue-acceptance.yml",
      "job": "acceptance",
      "argv": [
        "python3",
        "tools/issue_acceptance.py",
        "select",
        "--event",
        "$GITHUB_EVENT_PATH",
        "--event-name",
        "$GITHUB_EVENT_NAME",
        "--github-env",
        "$GITHUB_ENV",
        "--report",
        "$RUNNER_TEMP/issue-acceptance.json"
      ]
    },
    {
      "id": "acceptance-policy",
      "workflow": ".github/workflows/issue-acceptance.yml",
      "job": "acceptance",
      "argv": [
        "python3",
        "tools/issue_acceptance.py",
        "run",
        "--policy",
        "$ACCEPTANCE_POLICY",
        "--report",
        "$RUNNER_TEMP/issue-acceptance.json",
        "--require-clean",
        "--expected-source",
        "$ACCEPTANCE_SOURCE_SHA"
      ]
    },
    {
      "id": "site-basic",
      "workflow": ".github/workflows/site-checks.yml",
      "job": "checks",
      "argv": [
        "node",
        "tools/quality/local.cjs",
        "--package",
        "quality-artifact"
      ]
    }
  ],
