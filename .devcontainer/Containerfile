# Vendor-neutral development image (issue219). Any OCI builder (Docker, Podman,
# Buildah) and any Development Container host can build it. Versions match the
# pinned CI toolchain: Python 3.12.14 from this base, Node 24.19.0 below.
# The full base already ships git, curl and xz, so no unpinned apt step runs.
FROM docker.io/library/python:3.12.14-bookworm@sha256:dbbe4ceb97851e2e5fa83798b239811f871cb743b259ba3563737349f6bcfaa0

ARG NODE_VERSION=24.19.0
ARG NODE_SHA256_X64=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647
ARG NODE_SHA256_ARM64=01443c1e1a29e531ccad5a46fefa6df490d2189c49f7955904aecdbb0fe86fdc

RUN set -eu; \
  case "$(dpkg --print-architecture)" in \
    amd64) arch=x64; sum="$NODE_SHA256_X64" ;; \
    arm64) arch=arm64; sum="$NODE_SHA256_ARM64" ;; \
    *) echo "Unsupported architecture" >&2; exit 1 ;; \
  esac; \
  archive="node-v${NODE_VERSION}-linux-${arch}.tar.xz"; \
  curl --fail --silent --show-error --location --output "/tmp/${archive}" \
    "https://nodejs.org/dist/v${NODE_VERSION}/${archive}"; \
  echo "${sum}  /tmp/${archive}" | sha256sum --check --strict; \
  tar --extract --xz --file "/tmp/${archive}" --directory /usr/local --strip-components=1 \
    --no-same-owner --exclude="node-v${NODE_VERSION}-linux-${arch}/CHANGELOG.md" \
    --exclude="node-v${NODE_VERSION}-linux-${arch}/README.md"; \
  mkdir -p /usr/local/share/doc/node; \
  mv /usr/local/LICENSE /usr/local/share/doc/node/LICENSE; \
  rm "/tmp/${archive}"; \
  node --version; \
  npm --version

RUN useradd --create-home --shell /bin/bash dev
USER dev
