{
  "name": "Author site",
  "build": {
    "dockerfile": "Containerfile",
    "context": "."
  },
  "remoteUser": "dev",
  "postCreateCommand": "node tools/dev/cli.cjs setup && node tools/dev/cli.cjs agents",
  "containerEnv": {
    "OPENCODE_DISABLE_CLAUDE_CODE": "1"
  },
  "forwardPorts": [4173, 4096],
  "portsAttributes": {
    "4173": {
      "label": "Site preview",
      "onAutoForward": "notify"
    },
    "4096": {
      "label": "OpenCode server",
      "onAutoForward": "silent"
    }
  }
}
